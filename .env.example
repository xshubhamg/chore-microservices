# Copy to .env and export it (`set -a; source .env; set +a`) when running
# services locally with `go run`. The defaults in internal/platform/config cover
# the docker-compose setup, so this file is mostly documentation.

ENV=dev
LOG_LEVEL=info
VERSION=dev

# Infrastructure started by `make up-infra` (host ports).
DATABASE_URL=postgres://chore:chore@localhost:5435/chore_booking?sslmode=disable
RABBITMQ_URL=amqp://chore:chore@localhost:5672/
RABBITMQ_EXCHANGE=chore.events

# Only needed by the booking service.
CATALOG_GRPC_ADDR=localhost:50051

# Tracing is off when the endpoint is empty.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLE_RATIO=1

# Comma-separated ports for local runs (each service needs its own).
HTTP_ADDR=:3001
ADMIN_ADDR=:9091
GRPC_ADDR=:50051

# Test database for `make test-integration`.
TEST_DATABASE_URL=postgres://chore:chore@localhost:5435/chore_test?sslmode=disable
